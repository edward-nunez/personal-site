# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# LaunchDarkly Feature Flags & Observability
# This is the client-side ID (not a secret), specific to each project and environment
LD_CLIENT_ID=your-launchdarkly-client-side-id

# Disable LaunchDarkly browser analytics/diagnostic event POSTs
# true  => suppresses /events/bulk and /events/diagnostic requests
# false => keeps LaunchDarkly event/diagnostic posting enabled
LD_DISABLE_EVENTS=false

# Environment identifier for LaunchDarkly (development, staging, production)
VITE_API_ENV=development

# Session Replay Privacy Settings (optional, defaults to 'strict')
# - 'strict' (default): Obscures text inputs, password fields, and PII
# - 'default': Redacts text matching common PII regex patterns
# - 'none': No obfuscation (use only with explicit user consent)
VITE_SESSION_REPLAY_PRIVACY=strict
